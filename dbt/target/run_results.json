{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.0", "generated_at": "2026-08-03T18:34:17.106459Z", "invocation_id": "8cd46936-0e58-42de-9e4e-136d14f36baf", "invocation_started_at": "2026-08-03T18:34:09.795470Z", "env": {}}, "results": [{"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-03T18:34:14.245689Z", "completed_at": "2026-08-03T18:34:14.294410Z"}, {"name": "execute", "started_at": "2026-08-03T18:34:14.294948Z", "completed_at": "2026-08-03T18:34:15.152790Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 1.02783203125, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.biomass.dbt_utils_accepted_range_fem_mensual_final_endex_ancla_eur_t__400__100.2942ac3d78", "compiled": true, "compiled_code": "\n\nwith meet_condition as(\n  select *\n  from \"postgres\".\"analytics\".\"fem_mensual_final\"\n),\n\nvalidation_errors as (\n  select *\n  from meet_condition\n  where\n    -- never true, defaults to an empty result set. Exists to ensure any combo of the `or` clauses below succeeds\n    1 = 2\n    -- records with a value >= min_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not endex_ancla_eur_t >= 100\n    -- records with a value <= max_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not endex_ancla_eur_t <= 400\n)\n\nselect *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-03T18:34:14.253791Z", "completed_at": "2026-08-03T18:34:14.300088Z"}, {"name": "execute", "started_at": "2026-08-03T18:34:14.302703Z", "completed_at": "2026-08-03T18:34:15.167164Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 1.029831886291504, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.biomass.not_null_fem_mensual_final_endex_ancla_eur_t.c96da1c010", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect endex_ancla_eur_t\nfrom (select * from \"postgres\".\"analytics\".\"fem_mensual_final\" where mes >= '2025-01-01') dbt_subquery\nwhere endex_ancla_eur_t is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-03T18:34:14.219504Z", "completed_at": "2026-08-03T18:34:14.266114Z"}, {"name": "execute", "started_at": "2026-08-03T18:34:14.266743Z", "completed_at": "2026-08-03T18:34:15.170996Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 1.061905860900879, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.biomass.coherencia_unidades", "compiled": true, "compiled_code": "-- Test singular: en foto_semanal, \u20ac/MWh debe ser \u20ac/GJ * 3.6 (misma base energetica).\n-- dbt: el test PASA si esta consulta NO devuelve filas (ninguna fila incumple la regla).\n-- Se deja un margen de 0.05 por el redondeo a 2 decimales de cada columna por separado.\n\nwith comprobaciones as (\n    select fecha_issue, 'germany_depi'  as serie, germany_depi_eur_gj  as eur_gj, germany_depi_eur_mwh  as eur_mwh from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'austria_propellet', austria_propellet_eur_gj, austria_propellet_eur_mwh from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'swiss_preis',   swiss_preis_eur_gj,   swiss_preis_eur_mwh   from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'baltpool',      baltpool_eur_gj,      baltpool_eur_mwh      from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'endex_ancla',   endex_ancla_eur_gj,   endex_ancla_eur_mwh   from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'bulk_mid',      bulk_mid_eur_gj,      bulk_mid_eur_mwh      from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'bagged_mid',    bagged_mid_eur_gj,    bagged_mid_eur_mwh    from \"postgres\".\"analytics\".\"foto_semanal\"\n)\n\nselect *\nfrom comprobaciones\nwhere eur_gj is not null\n  and eur_mwh is not null\n  and abs(eur_mwh - eur_gj * 3.6) > 0.05", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-03T18:34:14.234042Z", "completed_at": "2026-08-03T18:34:14.292172Z"}, {"name": "execute", "started_at": "2026-08-03T18:34:14.292526Z", "completed_at": "2026-08-03T18:34:15.176653Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 1.0502121448516846, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.biomass.dbt_utils_accepted_range_fem_mensual_final_fx_eur_usd__1_5__0_5.a1a6c1a353", "compiled": true, "compiled_code": "\n\nwith meet_condition as(\n  select *\n  from \"postgres\".\"analytics\".\"fem_mensual_final\"\n),\n\nvalidation_errors as (\n  select *\n  from meet_condition\n  where\n    -- never true, defaults to an empty result set. Exists to ensure any combo of the `or` clauses below succeeds\n    1 = 2\n    -- records with a value >= min_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not fx_eur_usd >= 0.5\n    -- records with a value <= max_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not fx_eur_usd <= 1.5\n)\n\nselect *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-03T18:34:15.263469Z", "completed_at": "2026-08-03T18:34:15.27