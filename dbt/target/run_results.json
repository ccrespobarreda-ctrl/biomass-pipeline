{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.0", "generated_at": "2026-08-02T18:13:30.869348Z", "invocation_id": "04d26a65-90e7-4c69-9db8-ecc5b9c9ca3b", "invocation_started_at": "2026-08-02T18:13:25.033044Z", "env": {}}, "results": [{"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-02T18:13:28.040600Z", "completed_at": "2026-08-02T18:13:28.064918Z"}, {"name": "execute", "started_at": "2026-08-02T18:13:28.067146Z", "completed_at": "2026-08-02T18:13:28.864917Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.9285964965820312, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.biomass.dbt_utils_accepted_range_fem_mensual_final_endex_ancla_eur_t__400__100.2942ac3d78", "compiled": true, "compiled_code": "\n\nwith meet_condition as(\n  select *\n  from \"postgres\".\"analytics\".\"fem_mensual_final\"\n),\n\nvalidation_errors as (\n  select *\n  from meet_condition\n  where\n    -- never true, defaults to an empty result set. Exists to ensure any combo of the `or` clauses below succeeds\n    1 = 2\n    -- records with a value >= min_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not endex_ancla_eur_t >= 100\n    -- records with a value <= max_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not endex_ancla_eur_t <= 400\n)\n\nselect *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-02T18:13:28.008380Z", "completed_at": "2026-08-02T18:13:28.045458Z"}, {"name": "execute", "started_at": "2026-08-02T18:13:28.046908Z", "completed_at": "2026-08-02T18:13:28.904468Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 1.005406379699707, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.biomass.dbt_utils_accepted_range_fem_mensual_final_fx_eur_usd__1_5__0_5.a1a6c1a353", "compiled": true, "compiled_code": "\n\nwith meet_condition as(\n  select *\n  from \"postgres\".\"analytics\".\"fem_mensual_final\"\n),\n\nvalidation_errors as (\n  select *\n  from meet_condition\n  where\n    -- never true, defaults to an empty result set. Exists to ensure any combo of the `or` clauses below succeeds\n    1 = 2\n    -- records with a value >= min_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not fx_eur_usd >= 0.5\n    -- records with a value <= max_value are permitted. The `not` flips this to find records that don't meet the rule.\n    or not fx_eur_usd <= 1.5\n)\n\nselect *\nfrom validation_errors\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-02T18:13:28.026184Z", "completed_at": "2026-08-02T18:13:28.046321Z"}, {"name": "execute", "started_at": "2026-08-02T18:13:28.060733Z", "completed_at": "2026-08-02T18:13:28.912645Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.9904844760894775, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.biomass.coherencia_unidades", "compiled": true, "compiled_code": "-- Test singular: en foto_semanal, \u20ac/MWh debe ser \u20ac/GJ * 3.6 (misma base energetica).\n-- dbt: el test PASA si esta consulta NO devuelve filas (ninguna fila incumple la regla).\n-- Se deja un margen de 0.05 por el redondeo a 2 decimales de cada columna por separado.\n\nwith comprobaciones as (\n    select fecha_issue, 'germany_depi'  as serie, germany_depi_eur_gj  as eur_gj, germany_depi_eur_mwh  as eur_mwh from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'austria_propellet', austria_propellet_eur_gj, austria_propellet_eur_mwh from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'swiss_preis',   swiss_preis_eur_gj,   swiss_preis_eur_mwh   from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'baltpool',      baltpool_eur_gj,      baltpool_eur_mwh      from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'endex_ancla',   endex_ancla_eur_gj,   endex_ancla_eur_mwh   from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'bulk_mid',      bulk_mid_eur_gj,      bulk_mid_eur_mwh      from \"postgres\".\"analytics\".\"foto_semanal\"\n    union all\n    select fecha_issue, 'bagged_mid',    bagged_mid_eur_gj,    bagged_mid_eur_mwh    from \"postgres\".\"analytics\".\"foto_semanal\"\n)\n\nselect *\nfrom comprobaciones\nwhere eur_gj is not null\n  and eur_mwh is not null\n  and abs(eur_mwh - eur_gj * 3.6) > 0.05", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-02T18:13:28.029100Z", "completed_at": "2026-08-02T18:13:28.062202Z"}, {"name": "execute", "started_at": "2026-08-02T18:13:28.062787Z", "completed_at": "2026-08-02T18:13:28.906231Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.988940954208374, "adapter_response": {"_message": "SELECT 1", "code": "SELECT", "rows_affected": 1}, "message": null, "failures": 0, "unique_id": "test.biomass.not_null_fem_mensual_final_endex_ancla_eur_t.c96da1c010", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect endex_ancla_eur_t\nfrom (select * from \"postgres\".\"analytics\".\"fem_mensual_final\" where mes >= '2025-01-01') dbt_subquery\nwhere endex_ancla_eur_t is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-08-02T18:13:28.971925Z", "completed_at": "2026-08-02T18:13: