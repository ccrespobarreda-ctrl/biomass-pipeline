    finland_eur_mwh,
    sweden_eur_mwh,
    pine_pulpwood_usd,
    pine_chips_usd,
    pine_residuals_usd,
    lithuania_chips_eur_mwh
from fem_mensual
order by mes, issue_origen desc
  );
  
